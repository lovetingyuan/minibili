{
  "name": "minibili-monorepo",
  "private": true,
  "workspaces": [
    "app",
    "server",
    "bili-proxy"
  ],
  "scripts": {
    "format": "oxfmt .",
    "lint": "npm run lint --workspaces --if-present",
    "knip:app": "knip --workspace @minibili/app",
    "android": "npm run android -w=@minibili/app",
    "dev": "npm run dev -w=@minibili/app",
    "build:preview": "npm run build:android:preview -w=@minibili/app",
    "build:preview:eas": "npm run build:android:preview:eas -w=@minibili/app",
    "build:dev": "npm run build:android:dev -w=@minibili/app",
    "build:dev:eas": "npm run build:android:dev:eas -w=@minibili/app",
    "update": "npm run update -w=@minibili/app",
    "upgrade": "npm run update-expo -w=@minibili/app",
    "server": "npm run dev -w=@minibili/server",
    "proxy:dev": "npm run dev -w=@minibili/bili-proxy",
    "proxy:deploy": "npm run deploy -w=@minibili/bili-proxy",
    "deploy": "npm run deploy -w=@minibili/server",
    "build": "npm run build:android -w=@minibili/app"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "knip": "^6.34.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "npm": ">=10"
  }
}
