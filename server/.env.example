# 本地开发用的 Worker secret，复制成 .env.local（已 gitignore）。
# BILIBILI_PROXY_URL 来自 wrangler.jsonc 的 vars，这里只需要密钥。
# 取值与 Vercel 项目的 BILI_PROXY_TOKEN 完全一致。
BILIBILI_PROXY_TOKEN=replace-with-the-same-token-as-vercel

# /users 管理页的 HTTP Basic Auth 密码，用户名固定为 admin。
MINIBILI_MANAGEMENT_PASSWD=replace-with-a-strong-management-password
