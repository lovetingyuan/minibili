+++ b/node_modules/expo-video/android/src/main/java/expo/modules/video/player/BackgroundPlaybackTimer.kt
@@ -0,0 +1,124 @@
+package expo.modules.video.player
+
+import android.app.AlarmManager
+import android.content.Context
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemClock
+import android.util.Log
+import androidx.annotation.OptIn
+import androidx.media3.common.util.UnstableApi
+import expo.modules.video.listeners.VideoManagerListener
+import expo.modules.video.managers.VideoManager
+import java.lang.ref.WeakReference
+
+/** A sleep timer owned by a player, independent of React Native's suspended JS timers. */
+@OptIn(UnstableApi::class)
+class BackgroundPlaybackTimer(videoPlayer: VideoPlayer) : VideoManagerListener {
+  private val videoPlayer = WeakReference(videoPlayer)
+  private val handler = Handler(Looper.getMainLooper())
+  private val alarmManager = videoPlayer.context.getSystemService(Context.ALARM_SERVICE) as AlarmManager
+  private var alarm: AlarmManager.OnAlarmListener? = null
+  private var fallback: Runnable? = null
+  private var deadlineMs: Long? = null
+  private var generation = 0L
+  @Volatile private var released = false
+  private var expired = false
+
+  var timeoutSeconds = 0.0
+    set(value) {
+      require(value.isFinite() && value >= 0) { "backgroundPlaybackTimeout must be finite and non-negative" }
+      if (field == value || released) return
+      field = value
+      expired = false
+      schedule()
+    }
+
+  val hasTimedOut: Boolean
+    get() {
+      checkDeadline()
+      return expired
+    }
+
+  init {
+    VideoManager.registerListener(this)
+  }
+
+  override fun onAppBackgrounded() = onMain {
+    expired = false
+    schedule()
+  }
+
+  override fun onAppForegrounded() = onMain {
+    // Returning after the deadline must remain paused, even if the alarm was delayed.
+    checkDeadline()
+    cancel()
+  }
+
+  fun onPlaybackRequested() {
+    if (released) return
+    if (VideoManager.backgroundStartedAtMs == null) {
+      expired = false
+      return
+    }
+    checkDeadline()
+    // A queued autoplay or a media notification must not bypass this session's cutoff.
+    if (expired) videoPlayer.get()?.player?.pause()
+  }
+
+  fun release() {
+    released = true
+    onMain {
+      cancel()
+      VideoManager.unregisterListener(this)
+    }
+  }
+
+  private fun schedule() {
+    cancel()
+    val startedAt = VideoManager.backgroundStartedAtMs ?: return
+    if (released || timeoutSeconds <= 0) return
+    val deadline = startedAt + (timeoutSeconds * 1000).toLong()
+    deadlineMs = deadline
+    if (checkDeadline()) return
+
+    val token = generation
+    val callback = Runnable {
+      if (!released && token == generation) checkDeadline()
+    }
+    val listener = AlarmManager.OnAlarmListener { callback.run() }
+    alarm = listener
+    try {
+      // The listener overload needs no SCHEDULE_EXACT_ALARM permission. The existing
+      // media playback service keeps the process alive for the listener's lifetime.
+      alarmManager.setExact(AlarmManager.ELAPSED_REALTIME_WAKEUP, deadline, "expo-video-background-playback", listener, handler)
+    } catch (error: SecurityException) {
+      // Some OEMs may reject listener alarms; retain a native timer and the resume check.
+      Log.w("ExpoVideo", "Background playback alarm was rejected", error)
+      fallback = callback
+      handler.postDelayed(callback, (deadline - SystemClock.elapsedRealtime()).coerceAtLeast(0))
+    }
+  }
+
+  private fun checkDeadline(): Boolean {
+    val deadline = deadlineMs ?: return expired
+    if (released || SystemClock.elapsedRealtime() < deadline) return expired
+    expired = true
+    cancel()
+    videoPlayer.get()?.player?.pause()
+    return true
+  }
+
+  private fun cancel() {
+    generation += 1
+    alarm?.let { alarmManager.cancel(it) }
+    alarm = null
+    fallback?.let { handler.removeCallbacks(it) }
+    fallback = null
+    deadlineMs = null
+  }
+
+  private fun onMain(action: () -> Unit) {
+    if (Looper.myLooper() == Looper.getMainLooper()) action() else handler.post { action() }
+  }
+}
