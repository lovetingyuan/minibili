{
  "name": "@minibili/app",
  "version": "0.7.3",
  "gitHead": "11a7ca2",
  "description": "minimum bilibili apk",
  "homepage": "https://lovetingyuan.github.io/minibili/",
  "repository": "github:lovetingyuan/minibili",
  "files": [
    "apk",
    "docs"
  ],
  "main": "index.js",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "android": "npm run dev -- --android",
    "ios": "npm run dev -- --ios",
    "build:android": "zx scripts/build.mjs",
    "build:android:preview": "node scripts/build-android-local.mjs preview",
    "build:android:preview:eas": "cross-env APP_VARIANT=preview npx --yes eas-cli@latest build --platform android --profile preview --non-interactive",
    "build:android:dev": "node scripts/build-android-local.mjs",
    "build:android:dev:eas": "cross-env APP_VARIANT=development npx --yes eas-cli@latest build --platform android --profile development --non-interactive",
    "update": "npx --yes eas-cli@latest update --channel production --platform android --environment production",
    "doctor": "npx -y expo-doctor@latest",
    "test": "npx vitest run",
    "lint": "oxlint . --react-plugin --fix --fix-suggestions",
    "update-expo": "npm i -g eas-cli && npm install expo && npx expo install --fix && npm run doctor",
    "bundle-analyze": "npx --yes react-native-bundle-visualizer --platform android --entry-file index.js --expo true"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
